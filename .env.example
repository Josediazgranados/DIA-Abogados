# Motor de base de datos. Por defecto usa SQLite local (sin instalar nada).
# Para producción: DATABASE_URL=postgresql://usuario:clave@host:5432/dia_abogados
DATABASE_URL=sqlite:///./app/storage/casos.db

# Modo simulado para OTP/WhatsApp/correo (no requiere credenciales).
# Poner en "false" solo cuando haya integraciones reales configuradas.
NOTIFY_MOCK=true

# Datos de la campaña / caso (ver app/config.py para los valores por defecto)
DESCRIPCION_CASO=
APODERADO_NOMBRE=
APODERADO_TP=
APODERADO_EMAIL_RNA=
APODERADO_DOCUMENTO=
CLAUSULA_HONORARIOS=
CIUDAD_CASO=
